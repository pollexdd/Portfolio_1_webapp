// prisma/schema.prisma

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          String    @id @default(uuid())
  title       String
  description String
  category    String
  public      Boolean
  publishedAt DateTime
  status      String
  tags        Tag[]          // Endret til en relasjonstabell
  demos       Demo[]         // Endret til en relasjonstabell
  files       File[]         // Endret til en relasjonstabell
  author      Author @relation(fields: [authorId], references: [id])
  authorId    String
}

model Author {
  id          String    @id @default(uuid())
  name        String
  bio         String
  profileLink String
  projects    Project[]
}

model File {
  id        String   @id @default(uuid())
  name      String
  url       String
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

model Tag {
  id        String   @id @default(uuid())
  value     String
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}

model Demo {
  id        String   @id @default(uuid())
  url       String
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}
