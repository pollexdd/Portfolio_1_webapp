{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "Node",
    "isolatedModules": true,
    "outDir": "./dist/backend",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "composite": true
  },
  "include": [
    "src/backend/**/*.ts",
    "src/schemas/**/*.ts",
    "src/**/*.d.ts"
  ]
}